# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/expense-tracker

# JWT Secret (change this to a long random string!)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# JWT Expiry
JWT_EXPIRE=7d

# AI API Key (Optional - for AI suggestions)
GROQ_API_KEY=your_groq_api_key_here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Firebase Admin (Optional - for Firebase auth sync)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email
